HTTP_PORT=80
HTTPS_PORT=443
WHITELIST_HOSTS=
BLACKLIST_HOSTS="bad.example,evil.example"
BLACKLIST_REDIRECT="https://dnsredirect.eu/blacklisted"
HOME_DOMAIN=r.dnsredirect.eu

# Network binding (IPv6-only by default)
BIND_ADDRESS=::
# Set to true to also listen on IPv4 (dual-stack)
ENABLE_IPV4=false

# DNS resolver fallback URL (change if you prefer a different DNS-over-HTTPS)
RESOLVER_URL=https://dns.google/resolve
